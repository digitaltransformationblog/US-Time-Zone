].map(([abbr, name, zone, group, scene, landmark, sky1, sky2, earth, water, sun, mark]) => ({ abbr, name, zone, group, scene, landmark, sky1, sky2, earth, water, sun, mark }));

const grid = document.querySelector("#state-grid");
const template = document.querySelector("#state-template");
const search = document.querySelector("#state-search");
const filters = [...document.querySelectorAll(".filter")];
const formatterCache = new Map();
let activeFilter = "all";
let selectedCard = null;

function formatter(zone, options) {
  const key = `${zone}-${JSON.stringify(options)}`;
  if (!formatterCache.has(key)) formatterCache.set(key, new Intl.DateTimeFormat("en-US", { timeZone: zone, ...options }));
  return formatterCache.get(key);
}

function displayTime(zone, date) {
  return formatter(zone, { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false }).format(date);
}

function displayDate(zone, date) {
  return formatter(zone, { weekday: "short", month: "short", day: "numeric" }).format(date);
}

function zoneName(zone, date) {
  return formatter(zone, { timeZoneName: "short" }).formatToParts(date).find(part => part.type === "timeZoneName").value;
}

function buildCards() {
  states.forEach(state => {
    const fragment = template.content.cloneNode(true);
    const card = fragment.querySelector(".state-card");
    card.dataset.state = state.name.toLowerCase();
    card.dataset.group = state.group;
    card.dataset.scene = state.scene;
    card.setAttribute("aria-label", `${state.name}: local time and India time`);
    card.style.setProperty("--sky-1", state.sky1);
    card.style.setProperty("--sky-2", state.sky2);
    card.style.setProperty("--earth", state.earth);
    card.style.setProperty("--water", state.water);
    card.style.setProperty("--sun", state.sun);
    card.querySelector(".state-abbr").textContent = state.abbr;
    card.querySelector(".state-name").textContent = state.name;
    card.querySelector(".terrain-label").textContent = state.scene;
    card.querySelector(".landmark-label").textContent = state.landmark;
    card.querySelector(".landmark-mark").textContent = state.mark;
    card.dataset.zone = state.zone;
    card.addEventListener("click", () => spotlight(card));
    card.addEventListener("keydown", event => { if (event.key === "Enter" || event.key === " ") { event.preventDefault(); spotlight(card); } });
    grid.appendChild(fragment);
  });
}

function spotlight(card) {
  if (selectedCard) selectedCard.classList.remove("is-selected");
  selectedCard = card === selectedCard ? null : card;
  selectedCard?.classList.add("is-selected");
}

function updateClocks() {
  const now = new Date();
  const indiaTime = displayTime("Asia/Kolkata", now);
  const indiaDate = displayDate("Asia/Kolkata", now);
  const indiaClock = document.querySelector("#india-time");
  indiaClock.textContent = indiaTime;
  indiaClock.dateTime = now.toISOString();
  document.querySelector("#india-date").textContent = indiaDate;
  document.querySelectorAll(".state-card").forEach(card => {
    const zone = card.dataset.zone;
    const stateTime = card.querySelector(".state-time");
    stateTime.textContent = displayTime(zone, now);
    stateTime.dateTime = now.toISOString();
    card.querySelector(".zone-label").textContent = zoneName(zone, now);
    card.querySelector(".paired-india-time").textContent = indiaTime;
  });
  document.querySelector("#last-update").textContent = `Updated ${formatter("Asia/Kolkata", { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false }).format(now)} IST`;
}

function filterCards() {
  const query = search.value.trim().toLowerCase();
  let visible = 0;
  document.querySelectorAll(".state-card").forEach(card => {
    const matchQuery = card.dataset.state.includes(query) || card.querySelector(".state-abbr").textContent.toLowerCase().includes(query);
    const matchZone = activeFilter === "all" || card.dataset.group === activeFilter;
    const show = matchQuery && matchZone;
    card.hidden = !show;
    if (show) visible++;
  });
  document.querySelector("#state-count").textContent = visible;
  document.querySelector("#empty-state").hidden = visible !== 0;
}

filters.forEach(button => button.addEventListener("click", () => {
  activeFilter = button.dataset.filter;
  filters.forEach(item => item.classList.toggle("active", item === button));
  filterCards();
}));
search.addEventListener("input", filterCards);

buildCards();
updateClocks();
setInterval(updateClocks, 1000);

</script>
